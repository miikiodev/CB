{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 2,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "$comment": "Shared configuration for all supported platforms.",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
            }
        },
        {
            "name": "windows",
            "displayName": "Windows - MSVC x64",
            "inherits": "base",
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "toolset": "host=x64",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux",
            "displayName": "Linux - Clang",
            "inherits": "base",
            "generator": "Ninja Multi-Config",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_LINKER_TYPE": "LLD",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-debug",
            "configurePreset": "windows",
            "configuration": "Debug"
        },
        {
            "name": "windows-release",
            "configurePreset": "windows",
            "configuration": "Release"
        },
        {
            "name": "linux-debug",
            "configurePreset": "linux",
            "configuration": "Debug"
        },
        {
            "name": "linux-release",
            "configurePreset": "linux",
            "configuration": "Release"
        }
    ],
    "workflowPresets": [
    {
        "name": "windows-debug",
        "steps": [
            {
                "type": "configure",
                "name": "windows"
            },
            {
                "type": "build",
                "name": "windows-debug"
            }
        ]
    },
    {
        "name": "linux-debug",
        "steps": [
            {
                "type": "configure",
                "name": "linux"
            },
            {
                "type": "build",
                "name": "linux-debug"
            }
        ]
    },
    {
        "name": "windows-release",
        "steps": [
            {
                "type": "configure",
                "name": "windows"
            },
            {
                "type": "build",
                "name": "windows-release"
            }
        ]
    },
    {
        "name": "linux-release",
        "steps": [
            {
                "type": "configure",
                "name": "linux"
            },
            {
                "type": "build",
                "name": "linux-release"
            }
        ]
    }
]
}